%bcond_without  check
%bcond_without  use_system_libuv

Name:           plumbum
Version:        @VERSION@
Release:        @RELEASE@
Summary:        A cross-platform V2Ray graphical front-end
License:        GPLv3
URL:            https://plumbum.net/

# Source0 is created by:
# pip install git-archive-all
# git clone https://github.com/Plumbum/Plumbum.git
# cd Plumbum
# git archive-all --force-submodules ../@SOURCE0@
Source0:        @SOURCE0@

%if %{with check}
BuildRequires:  desktop-file-utils
BuildRequires:  libappstream-glib
%endif

%if %{with use_system_libuv}
BuildRequires:  libuv-devel >= 1.38.1
%endif

BuildRequires:  cmake >= 3.10.1
BuildRequires:  gcc
BuildRequires:  gcc-c++
BuildRequires:  libcurl-devel
BuildRequires:  protobuf-devel
BuildRequires:  grpc-devel
BuildRequires:  grpc-plugins
BuildRequires:  cmake(Qt5)
BuildRequires:  cmake(Qt5Svg)
BuildRequires:  cmake(Qt5LinguistTools)
Requires:       hicolor-icon-theme

Recommends:     %{name}-plugin-builtin-protocol-support%{?_isa} = %{version}-%{release}
Recommends:     %{name}-plugin-builtin-subscription-support%{?_isa} = %{version}-%{release}

%package plugin-builtin-protocol-support
Summary:        Plumbum Builtin Protocol Support
Requires:       %{name}%{?_isa} = %{version}-%{release}

%package plugin-builtin-subscription-support
Summary:        Plumbum Builtin Subscription Support
Requires:       %{name}%{?_isa} = %{version}-%{release}

%description
Plumbum is a cross-platform v2ray graphical front-end written in Qt.
Features:
    * Cross-platform, multi-distribution support
    * Versatile Host Importing
    * Subscriptions
    * Built-in Host Editors
    * (Almost) Full Functionality Support
    * Real-time Speed & Data Usage Monitoring
    * Latency Testing (TCP)
For more details please see %{url}

%description plugin-builtin-protocol-support
VMess, VLESS, SOCKS, HTTP, Shadowsocks, DNS, Dokodemo-door editor support.

%description plugin-builtin-subscription-support
Basic subscription support for Plumbum.


%prep
%autosetup -n @NAME_VERSION@


%build
%cmake                    -DPLUMBUM_DISABLE_AUTO_UPDATE=ON \
%{?with_check:            -DBUILD_TESTING=ON} \
%{?with_use_system_libuv: -DUSE_SYSTEM_LIBUV=ON} \
                          -DPLUMBUM_BUILD_INFO="Plumbum built from rpmbuild" \
                          -DPLUMBUM_BUILD_EXTRA_INFO="$(rpmbuild --version), kernel-$(uname -r), qt-$(pkg-config --modversion Qt5Core)" \
                          -DPLUMBUM_DEFAULT_VCORE_PATH="%{_bindir}/v2ray" \
                          -DPLUMBUM_DEFAULT_VASSETS_PATH="%{_datadir}/v2ray" \
                          -DCMAKE_BUILD_TYPE="Release"
%cmake_build


%install
%cmake_install

# Find lang files
%find_lang %{name} --with-qt --all-name
# https://bugzilla.redhat.com/show_bug.cgi?id=1894854
echo "%%lang(yue_HK) %{_datadir}/plumbum/lang/yue.qm" >> %{name}.lang

# Find icon files
grep "%{_datadir}/icons/hicolor/.*" %{__cmake_builddir}/install_manifest.txt >> %{name}.icons


%if %{with check}
%check
desktop-file-validate                 %{buildroot}%{_datadir}/applications/plumbum.desktop
appstream-util validate-relax --nonet %{buildroot}%{_metainfodir}/plumbum.metainfo.xml
%ctest
%endif


%files -f %{name}.lang -f %{name}.icons
%license LICENSE
%doc README.md
%{_bindir}/plumbum
%{_metainfodir}/plumbum.metainfo.xml
%{_datadir}/applications/plumbum.desktop
%dir %{_datadir}/plumbum/
%dir %{_datadir}/plumbum/lang/
%dir %{_datadir}/plumbum/plugins/

%files plugin-builtin-protocol-support
%{_datadir}/plumbum/plugins/libQvPlugin-BuiltinProtocolSupport.so

%files plugin-builtin-subscription-support
%{_datadir}/plumbum/plugins/libQvPlugin-BuiltinSubscriptionSupport.so


%changelog
